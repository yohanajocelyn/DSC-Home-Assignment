erDiagram
    users {
        bigint id PK
        bigint role_id FK
        varchar name
        varchar email UK
        datetime email_verified_at "nullable"
        varchar password
    }

    roles {
        bigint id PK
        varchar name
    }

    meeting_rooms {
        bigint id PK
        string name
        string location
        int capacity
        text description
        boolean is_active "default: true"
    }

    bookings {
        bigint id PK
        bigint user_id FK
        bigint meeting_room_id FK
        string title
        date date
        time start_time
        time end_time
        boolean is_active "default: true"
    }

    %% Relationships
    users ||--o{ bookings : "has many"
    roles ||--o{ users : "has many"
    meeting_rooms ||--o{ bookings : "has many"
